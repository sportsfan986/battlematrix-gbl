<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team Preset Name"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edit_preset_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Great League Team"
            android:inputType="textCapWords"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battle League"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_league"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: Leave Moves or IVs blank to auto-fill PvPoke recommended moves &amp; default IVs."
            android:textSize="11sp"
            android:textColor="#64748b"
            android:layout_marginBottom="10dp" />

        <!-- Pokemon 1 (Lead) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lead Pokémon (Slot 1) &amp; Moveset"
            android:textStyle="bold"
            android:textColor="#2563eb"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_p1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:textSize="13sp"
                android:hint="Name (e.g. Clodsire)" />

            <EditText
                android:id="@+id/edit_p1_cp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:textSize="12sp"
                android:hint="CP (auto)"
                android:inputType="number" />

            <EditText
                android:id="@+id/edit_p1_ivs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:textSize="12sp"
                android:hint="IVs (opt 0/15/15)"
                android:inputType="text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/edit_p1_fast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Fast (auto)" />

            <EditText
                android:id="@+id/edit_p1_c1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Charged 1 (auto)" />

            <EditText
                android:id="@+id/edit_p1_c2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Charged 2 (auto)" />
        </LinearLayout>

        <!-- Pokemon 2 (Safe Swap) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe Swap (Slot 2) &amp; Moveset"
            android:textStyle="bold"
            android:textColor="#2563eb"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_p2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:textSize="13sp"
                android:hint="Name (e.g. Feraligatr)" />

            <EditText
                android:id="@+id/edit_p2_cp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:textSize="12sp"
                android:hint="CP (auto)"
                android:inputType="number" />

            <EditText
                android:id="@+id/edit_p2_ivs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:textSize="12sp"
                android:hint="IVs (opt 0/15/15)"
                android:inputType="text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/edit_p2_fast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Fast (auto)" />

            <EditText
                android:id="@+id/edit_p2_c1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Charged 1 (auto)" />

            <EditText
                android:id="@+id/edit_p2_c2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Charged 2 (auto)" />
        </LinearLayout>

        <!-- Pokemon 3 (Closer) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Closer (Slot 3) &amp; Moveset"
            android:textStyle="bold"
            android:textColor="#2563eb"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_p3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:textSize="13sp"
                android:hint="Name (e.g. Mandibuzz)" />

            <EditText
                android:id="@+id/edit_p3_cp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:textSize="12sp"
                android:hint="CP (auto)"
                android:inputType="number" />

            <EditText
                android:id="@+id/edit_p3_ivs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:textSize="12sp"
                android:hint="IVs (opt 0/15/15)"
                android:inputType="text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_p3_fast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Fast (auto)" />

            <EditText
                android:id="@+id/edit_p3_c1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Charged 1 (auto)" />

            <EditText
                android:id="@+id/edit_p3_c2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:hint="Charged 2 (auto)" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
