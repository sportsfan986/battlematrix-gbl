<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_preset_dialog_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0f172a">

    <!-- Centered Background Emblem Watermark (Shown when theme watermarks are enabled) -->
    <ImageView
        android:id="@+id/iv_preset_dialog_watermark"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:alpha="0.22"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Team Name & League Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Team Preset Name"
                    android:textColor="#38bdf8"
                    android:textStyle="bold"
                    android:textSize="12.5sp" />

                <EditText
                    android:id="@+id/edit_preset_name"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="#0f172a"
                    android:paddingHorizontal="8dp"
                    android:hint="e.g. Great League Team"
                    android:textColor="#f8fafc"
                    android:textColorHint="#94a3b8"
                    android:textSize="13sp"
                    android:inputType="textCapWords" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battle League"
                    android:textColor="#f59e0b"
                    android:textStyle="bold"
                    android:textSize="12.5sp" />

                <Spinner
                    android:id="@+id/spinner_league"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="#0f172a"
                    android:paddingHorizontal="6dp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tip: Type a base Pokémon name to open the autocomplete dropdown with Base, Shadow, and Alternate Forms, auto-filling PvPoke recommended moves!"
                    android:textSize="10.5sp"
                    android:textColor="#94a3b8" />
            </LinearLayout>

            <!-- Team Style (ABB vs ABC), Aggregate BR & Slot Ordering Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/text_dialog_archetype_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Style: ABC  •  Lead BR: 500 (N)  •  Mach BR: 600"
                    android:textColor="#f8fafc"
                    android:textStyle="bold"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/text_dialog_meta_blend_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blended Current-Season Meta (Recency-weighted logs + PvPoke prior)"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_dialog_auto_detect_style"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.5"
                        android:text="⚡ Auto-Detect &amp; Order"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="#d97706"
                        android:textColor="#ffffff"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_swap_slot_1_2"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="#1 ⇄ #2"
                        android:textSize="10.5sp"
                        android:backgroundTint="#334155"
                        android:textColor="#e2e8f0"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_swap_slot_2_3"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="#2 ⇄ #3"
                        android:textSize="10.5sp"
                        android:backgroundTint="#334155"
                        android:textColor="#e2e8f0" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pokemon 1 (Lead) Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/text_p1_role_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚔️ Lead Pokémon (Slot 1) &amp; Moveset"
                        android:textStyle="bold"
                        android:textColor="#38bdf8"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/text_p1_lead_br"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lead BR: 500 (N)"
                        android:textStyle="bold"
                        android:textColor="#cbd5e1"
                        android:textSize="10.5sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/edit_p1_name"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.8"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:completionThreshold="1"
                        android:dropDownWidth="280dp"
                        android:inputType="textCapWords"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="12sp"
                        android:hint="Name (e.g. Clodsire)" />

                    <EditText
                        android:id="@+id/edit_p1_cp"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="0.85"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="CP (auto)"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/edit_p1_ivs"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.05"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="IVs (0/15/15)"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edit_p1_fast"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Fast (auto)" />

                    <EditText
                        android:id="@+id/edit_p1_c1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 1" />

                    <EditText
                        android:id="@+id/edit_p1_c2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pokemon 2 (Safe Swap) Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/text_p2_role_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔄 Safe Swap (Slot 2) &amp; Moveset"
                        android:textStyle="bold"
                        android:textColor="#f59e0b"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/text_p2_swap_br"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swap BR: 500 (N)"
                        android:textStyle="bold"
                        android:textColor="#cbd5e1"
                        android:textSize="10.5sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/edit_p2_name"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.8"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:completionThreshold="1"
                        android:dropDownWidth="280dp"
                        android:inputType="textCapWords"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="12sp"
                        android:hint="Name (e.g. Feraligatr)" />

                    <EditText
                        android:id="@+id/edit_p2_cp"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="0.85"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="CP (auto)"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/edit_p2_ivs"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.05"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="IVs (0/15/15)"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edit_p2_fast"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Fast (auto)" />

                    <EditText
                        android:id="@+id/edit_p2_c1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 1" />

                    <EditText
                        android:id="@+id/edit_p2_c2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pokemon 3 (Closer) Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/text_p3_role_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛡️ Closer (Slot 3) &amp; Moveset"
                        android:textStyle="bold"
                        android:textColor="#38bdf8"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/text_p3_swap_br"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swap BR: 500 (N)"
                        android:textStyle="bold"
                        android:textColor="#cbd5e1"
                        android:textSize="10.5sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/edit_p3_name"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.8"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:completionThreshold="1"
                        android:dropDownWidth="280dp"
                        android:inputType="textCapWords"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="12sp"
                        android:hint="Name (e.g. Mandibuzz)" />

                    <EditText
                        android:id="@+id/edit_p3_cp"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="0.85"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="CP (auto)"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/edit_p3_ivs"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.05"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="IVs (0/15/15)"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edit_p3_fast"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Fast (auto)" />

                    <EditText
                        android:id="@+id/edit_p3_c1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 1" />

                    <EditText
                        android:id="@+id/edit_p3_c2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 2" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
