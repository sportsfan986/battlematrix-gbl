<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#1e293b"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <RadioButton
        android:id="@+id/radio_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#38bdf8"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_preset_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Master League Meta"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_preset_league"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MASTER LEAGUE"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:background="#0f172a"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_preset_pokemon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dialga (4624) • Lugia (4179) • Kyogre (4652)"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_delete_preset"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Preset" />

</LinearLayout>
