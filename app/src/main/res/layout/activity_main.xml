<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#0f172a"
    android:padding="16dp">

    <!-- Top Header Row with App Icon, Title & Support/Donate Link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_gbl_logo"
            android:contentDescription="BattleMatrix GBL Icon"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BattleMatrix GBL"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#f8fafc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-Time PvP Floating Overlay • v1.20"
                android:textSize="11sp"
                android:textColor="#94a3b8"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_donate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="☕ Support"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#f59e0b"
            android:textColor="#0f172a" />
    </LinearLayout>

    <!-- Status & Settings Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Idle (Ready to launch overlay)"
            android:textColor="#38bdf8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_db_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PvPoke Database: Cached (Checking...)"
            android:textColor="#cbd5e1"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_toggle_overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#2563eb"
                android:textColor="#ffffff"
                android:text="Start Battle Overlay" />

            <Button
                android:id="@+id/btn_download_db"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#334155"
                android:textColor="#ffffff"
                android:text="Sync PvPoke" />
        </LinearLayout>

        <!-- Opponent Fast Move Count Basis Setting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:background="#0f172a"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opponent Move Count Basis"
                    android:textColor="#e2e8f0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_opp_count_basis_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default: Counts shown in My Fast Moves"
                    android:textColor="#94a3b8"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_toggle_opp_count_basis"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="My Fasts"
                android:textSize="11sp"
                android:backgroundTint="#0284c7"
                android:textColor="#ffffff" />
        </LinearLayout>

        <!-- Overlay Screen Width Scale Slider (50% - 100%, Default 78%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:background="#0f172a"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Overlay Size (% of Screen Width)"
                    android:textColor="#e2e8f0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_overlay_scale_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="78% (Default)"
                    android:textColor="#38bdf8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekbar_overlay_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="25"
                android:progress="14"
                android:progressTint="#38bdf8"
                android:thumbTint="#38bdf8" />

            <!-- Scale Bounds & Default Tick Marker (78% is 14/25 = 56% along 50%-100% track) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="14"
                    android:text="50%"
                    android:textColor="#64748b"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/text_overlay_scale_default_tick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲ 78% Default"
                    android:textColor="#38bdf8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="4dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="11"
                    android:gravity="end"
                    android:text="100%"
                    android:textColor="#64748b"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Team Presets Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GBL Team Presets"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#e2e8f0" />

        <Button
            android:id="@+id/btn_add_preset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ New Team"
            android:textSize="12sp"
            android:backgroundTint="#059669"
            android:textColor="#ffffff" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layout_presets_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
