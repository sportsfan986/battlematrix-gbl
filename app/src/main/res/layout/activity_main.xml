<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#0f172a"
    android:padding="14dp">

    <!-- Top Header Row with App Icon, Title & Support/Donate Link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_gbl_logo"
            android:contentDescription="SilphScope PvP Icon"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SilphScope PvP"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#f8fafc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-Time PvP Floating Overlay • v2.03"
                android:textSize="11sp"
                android:textColor="#94a3b8"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_donate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="☕ Support"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#f59e0b"
            android:textColor="#0f172a" />
    </LinearLayout>

    <!-- Persistent Overlay Launch & Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Idle (Ready to launch overlay)"
                    android:textColor="#38bdf8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tip: Tap ⚔️ in overlay to minimize &amp; pause OCR"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_toggle_overlay"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#2563eb"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Start Battle Overlay" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3-Page Navigation Switcher Bar (Teams | Settings | Battle Log) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#020617"
        android:padding="4dp"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btn_nav_teams"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="⚔️ Teams"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#0284c7"
            android:textColor="#ffffff"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_nav_settings"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="⚙️ Settings"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#1e293b"
            android:textColor="#94a3b8"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_nav_battle_log"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="📜 Battle Log"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#1e293b"
            android:textColor="#94a3b8" />
    </LinearLayout>

    <!-- Quick Undo Banner for Accidentally Deleted Battles or Teams -->
    <LinearLayout
        android:id="@+id/layout_undo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#064e3b"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_undo_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item moved to Trash"
            android:textColor="#ecfdf5"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_undo_action"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="↩ UNDO"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:backgroundTint="#10b981"
            android:textColor="#022c22"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_undo_dismiss"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textSize="10.5sp"
            android:backgroundTint="#047857"
            android:textColor="#ffffff" />
    </LinearLayout>

    <!-- ===================================================================
         PAGE 1: GBL TEAM PRESETS (Default Active Page)
         =================================================================== -->
    <LinearLayout
        android:id="@+id/page_teams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GBL Team Presets"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#e2e8f0" />

            <Button
                android:id="@+id/btn_trash_presets"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑️ Trash"
                android:textSize="11sp"
                android:backgroundTint="#334155"
                android:textColor="#cbd5e1"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_add_preset"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ New Team"
                android:textSize="12sp"
                android:backgroundTint="#059669"
                android:textColor="#ffffff" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layout_presets_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================================================================
         PAGE 2: OVERLAY & PVPOKE DATABASE SETTINGS
         =================================================================== -->
    <ScrollView
        android:id="@+id/page_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1e293b"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overlay &amp; Database Configuration"
                android:textColor="#f8fafc"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- PvPoke Database & 4-League Sync Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0f172a"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PvPoke Live Database &amp; 4 Leagues"
                        android:textColor="#38bdf8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_download_db"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#334155"
                        android:textColor="#ffffff"
                        android:textSize="11sp"
                        android:text="Sync PvPoke" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_db_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PvPoke Database: Cached (Checking...)"
                    android:textColor="#cbd5e1"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Opponent Fast Move Count Basis Setting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:paddingTop="8dp"
                android:background="#0f172a"
                android:paddingHorizontal="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opponent Move Count Basis"
                        android:textColor="#e2e8f0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_opp_count_basis_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default: Counts shown in My Fast Moves"
                        android:textColor="#94a3b8"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_toggle_opp_count_basis"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="My Fasts"
                    android:textSize="11sp"
                    android:backgroundTint="#0284c7"
                    android:textColor="#ffffff" />
            </LinearLayout>

            <!-- Opponent Charged Moves Count Setting (3 vs 4 Charged Moves in Overlay) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:paddingTop="8dp"
                android:background="#0f172a"
                android:paddingHorizontal="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opponent Charged Moves in Overlay"
                        android:textColor="#e2e8f0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_opp_charged_moves_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default: 3 Charged Moves (Official + Top Usage)"
                        android:textColor="#94a3b8"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_toggle_opp_charged_moves"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="3 Moves"
                    android:textSize="11sp"
                    android:backgroundTint="#0284c7"
                    android:textColor="#ffffff" />
            </LinearLayout>

            <!-- Overlay Screen Width Scale Slider (50% - 100%, Default 78%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="#0f172a"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overlay Size (% of Screen Width)"
                        android:textColor="#e2e8f0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_overlay_scale_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="78% (Default)"
                        android:textColor="#38bdf8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_overlay_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="25"
                    android:progress="14"
                    android:progressTint="#38bdf8"
                    android:thumbTint="#38bdf8" />

                <!-- Scale Bounds & Default Tick Marker (78% is 14/25 = 56% along 50%-100% track) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="14"
                        android:text="50%"
                        android:textColor="#64748b"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/text_overlay_scale_default_tick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲ 78% Default"
                        android:textColor="#38bdf8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="11"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="#64748b"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Overlay Background Transparency Slider (0% - 100%, Default 72%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="#0f172a"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overlay Background Transparency"
                        android:textColor="#e2e8f0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_overlay_transparency_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="72% (Default)"
                        android:textColor="#38bdf8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adjusts background glass only — text &amp; move bars stay 100% crisp"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:layout_marginTop="1dp" />

                <SeekBar
                    android:id="@+id/seekbar_overlay_transparency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="50"
                    android:progress="36"
                    android:progressTint="#38bdf8"
                    android:thumbTint="#38bdf8" />

                <!-- Transparency Bounds & Default Tick Marker (72% is 36/50 = 72% along 0%-100% track) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="36"
                        android:text="0% (Solid)"
                        android:textColor="#64748b"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/text_overlay_transparency_default_tick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲ 72% Default"
                        android:textColor="#38bdf8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="4dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="14"
                        android:gravity="end"
                        android:text="100% (Clear)"
                        android:textColor="#64748b"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Two-Device Cloud & Delta Reconciliation Sync Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="#0f172a"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️ Multi-Device Auto Delta Sync (Teams &amp; Battle Logs)"
                    android:textColor="#38bdf8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in with your GitHub account once on each of your phones. Each user's logs sync privately to their own GitHub account automatically on app open &amp; after every battle."
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />

                <Button
                    android:id="@+id/btn_github_login_settings"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:text="🔑 Login with GitHub (Generate Sync Token)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#10b981"
                    android:textColor="#ffffff" />

                <EditText
                    android:id="@+id/edit_sync_github_token"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:background="#1e293b"
                    android:paddingHorizontal="8dp"
                    android:hint="GitHub OAuth / Personal Access Token (Auto-filled on Login)"
                    android:textColor="#f8fafc"
                    android:textColorHint="#64748b"
                    android:textSize="11sp"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/edit_sync_gist_id"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="#1e293b"
                    android:paddingHorizontal="8dp"
                    android:hint="Optional Gist ID Override (Auto-discovered per user account)"
                    android:textColor="#f8fafc"
                    android:textColorHint="#64748b"
                    android:textSize="11sp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btn_sync_devices_settings"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="☁️ Sync Devices Now"
                        android:textSize="11sp"
                        android:backgroundTint="#0284c7"
                        android:textColor="#ffffff"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_sync_bundle_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="📦 Sync Bundle"
                        android:textSize="11sp"
                        android:backgroundTint="#334155"
                        android:textColor="#e2e8f0" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sync Status: Not signed in (Local storage active)"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===================================================================
         PAGE 3: BATTLE LOG (Per-League/Team Logging, Season Export & Replay)
         =================================================================== -->
    <LinearLayout
        android:id="@+id/page_battle_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GBL Battle Log &amp; Replay"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#e2e8f0" />

            <Button
                android:id="@+id/btn_log_manual_battle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="+ Log"
                android:textSize="10.5sp"
                android:backgroundTint="#0284c7"
                android:textColor="#ffffff"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_sync_battle_log"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="☁️ Sync"
                android:textSize="10.5sp"
                android:backgroundTint="#0369a1"
                android:textColor="#ffffff"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_trash_battle_log"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🗑️ Trash"
                android:textSize="10.5sp"
                android:backgroundTint="#334155"
                android:textColor="#fcd34d"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_clear_battle_log"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Clear"
                android:textSize="10.5sp"
                android:backgroundTint="#334155"
                android:textColor="#cbd5e1" />
        </LinearLayout>

        <!-- Filter Row 1: League & Team Preset Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Spinner
                android:id="@+id/spinner_log_filter_league"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#1e293b"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/spinner_log_filter_team"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.2"
                android:background="#1e293b"
                android:paddingHorizontal="6dp" />
        </LinearLayout>

        <!-- Filter Row 2: Timeframe Filter (Day/Week/Current Season/Prev Season/All) + Copy & Share -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <Spinner
                android:id="@+id/spinner_log_filter_timeframe"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#1e293b"
                android:paddingHorizontal="6dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_copy_battle_log"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📋 Copy Text"
                android:textSize="10.5sp"
                android:backgroundTint="#1e293b"
                android:textColor="#38bdf8"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_share_battle_log"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📤 Share"
                android:textSize="10.5sp"
                android:backgroundTint="#0284c7"
                android:textColor="#ffffff" />
        </LinearLayout>

        <!-- Summary Metrics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="8dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECORD (W - L)"
                    android:textColor="#94a3b8"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_battle_log_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0W - 0L"
                    android:textColor="#38bdf8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="8dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEAD MATCHUPS"
                    android:textColor="#94a3b8"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_battle_log_league"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Fav · 0 Neu · 0 Neg"
                    android:textColor="#34d399"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIN RATE"
                    android:textColor="#94a3b8"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_battle_log_winrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—%"
                    android:textColor="#fbbf24"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layout_battle_log_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
