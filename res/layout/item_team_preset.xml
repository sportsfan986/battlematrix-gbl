<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#1e293b"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/drag_handle_preset"
        android:layout_width="24dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="⋮⋮"
        android:textColor="#64748b"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginEnd="6dp"
        android:contentDescription="Hold and drag to rearrange team order" />

    <RadioButton
        android:id="@+id/radio_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#38bdf8"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_preset_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Great League Team"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/text_preset_archetype_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABC"
                android:textColor="#38bdf8"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:background="#0f172a"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/text_preset_league"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GREAT LEAGUE"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:background="#0f172a"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_preset_metrics_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lead BR: 512 (N)  •  Mach BR: 642 (Solid)  •  Swap BR: 518 / 496"
            android:textColor="#94a3b8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/text_preset_pokemon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clodsire (1494) • Feraligatr (1498) • Mandibuzz (1496)"
            android:textColor="#cbd5e1"
            android:textSize="11.5sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="4dp">

        <TextView
            android:id="@+id/btn_move_preset_up"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="▲"
            android:textSize="10sp"
            android:textColor="#94a3b8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move Preset Up" />

        <TextView
            android:id="@+id/btn_move_preset_down"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="▼"
            android:textSize="10sp"
            android:textColor="#94a3b8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move Preset Down" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_auto_detect_preset"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="0dp"
        android:layout_marginStart="4dp"
        android:text="⚡ Auto"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:backgroundTint="#d97706"
        android:textColor="#ffffff"
        android:contentDescription="Auto-detect ABB vs ABC style and move recommended Safe Swap to Slot 2" />

    <ImageButton
        android:id="@+id/btn_edit_preset"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="2dp"
        android:src="@android:drawable/ic_menu_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit Team &amp; Moves" />

    <ImageButton
        android:id="@+id/btn_delete_preset"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Preset" />

</LinearLayout>
