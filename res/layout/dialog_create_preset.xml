<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team Preset Name"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edit_preset_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Master: Dialga / Lugia / Kyogre"
            android:inputType="textCapWords"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battle League"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_league"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Pokemon 1 (Lead) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lead Pokémon (Slot 1)"
            android:textStyle="bold"
            android:textColor="#2563eb"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/edit_p1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="Pokémon Name (e.g. Dialga)" />

            <EditText
                android:id="@+id/edit_p1_cp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="CP"
                android:inputType="number" />
        </LinearLayout>

        <!-- Pokemon 2 (Safe Swap) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safe Swap (Slot 2)"
            android:textStyle="bold"
            android:textColor="#2563eb"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/edit_p2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="Pokémon Name (e.g. Lugia)" />

            <EditText
                android:id="@+id/edit_p2_cp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="CP"
                android:inputType="number" />
        </LinearLayout>

        <!-- Pokemon 3 (Closer) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Closer (Slot 3)"
            android:textStyle="bold"
            android:textColor="#2563eb"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_p3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="Pokémon Name (e.g. Kyogre)" />

            <EditText
                android:id="@+id/edit_p3_cp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="CP"
                android:inputType="number" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
