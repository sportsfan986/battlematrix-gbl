<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_preset_dialog_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0f172a">

    <!-- Centered Background Emblem Watermark (Shown when theme watermarks are enabled) -->
    <ImageView
        android:id="@+id/iv_preset_dialog_watermark"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:alpha="0.22"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Team Name & League Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Team Preset Name"
                    android:textColor="#38bdf8"
                    android:textStyle="bold"
                    android:textSize="12.5sp" />

                <EditText
                    android:id="@+id/edit_preset_name"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="#0f172a"
                    android:paddingHorizontal="8dp"
                    android:hint="e.g. Great League Team"
                    android:textColor="#f8fafc"
                    android:textColorHint="#94a3b8"
                    android:textSize="13sp"
                    android:inputType="textCapWords" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battle League"
                    android:textColor="#f59e0b"
                    android:textStyle="bold"
                    android:textSize="12.5sp" />

                <Spinner
                    android:id="@+id/spinner_league"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="#0f172a"
                    android:paddingHorizontal="6dp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tip: Type a base Pokémon name to open the autocomplete dropdown with Base, Shadow, and Alternate Forms, auto-filling PvPoke recommended moves!"
                    android:textSize="10.5sp"
                    android:textColor="#94a3b8" />
            </LinearLayout>

            <!-- ABB / ABC Team Style Auto-Detection, Aggregate BR & Safe Swap Reordering Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <!-- Top Badges Row: Style [ABB/ABC], Lead Agg BR (SW/W/N/L/SL), Machine Agg BR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/text_dialog_archetype_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Style: [ABC]"
                        android:textColor="#38bdf8"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/text_dialog_lead_br_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lead Agg BR: 500 (N)"
                        android:textColor="#f59e0b"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/text_dialog_mach_br_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mach Agg BR: 600 (Playable)"
                        android:textColor="#eab308"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <!-- Style Mode Override Selector (Style Mode: AUTO | ABB | ABC) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Style Mode:"
                        android:textColor="#94a3b8"
                        android:textStyle="bold"
                        android:textSize="10.5sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_mode_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="AUTO"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="#0284c7"
                        android:textColor="#ffffff"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_mode_abb"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="ABB"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="#334155"
                        android:textColor="#cbd5e1"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_mode_abc"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="ABC"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:backgroundTint="#334155"
                        android:textColor="#cbd5e1" />
                </LinearLayout>

                <!-- Auto-Detect & Manual Slot Swap Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <Button
                        android:id="@+id/btn_dialog_auto_detect_style"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.6"
                        android:minWidth="0dp"
                        android:paddingHorizontal="6dp"
                        android:text="⚡ Auto-Detect Style &amp; Move Safe Swap"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:backgroundTint="#d97706"
                        android:textColor="#ffffff"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_swap_slot_1_2"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="Slot 1 ⇄ 2"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:backgroundTint="#334155"
                        android:textColor="#e2e8f0"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_swap_slot_2_3"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="Slot 2 ⇄ 3"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:backgroundTint="#334155"
                        android:textColor="#e2e8f0" />
                </LinearLayout>

                <!-- Backline Swap BR & Shared Weaknesses Breakdown -->
                <TextView
                    android:id="@+id/text_dialog_archetype_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Slot 2 Swap BR: 500 (N)  •  Slot 3 Swap BR: 500 (N)"
                    android:textColor="#e2e8f0"
                    android:textStyle="bold"
                    android:textSize="10.5sp" />

                <!-- Current Season Meta Blend Info -->
                <TextView
                    android:id="@+id/text_dialog_meta_blend_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current Season Meta Blend: 0% Recency-Weighted Logs (0 matches) / 100% PvPoke"
                    android:textColor="#94a3b8"
                    android:textSize="9.5sp"
                    android:layout_marginTop="2dp" />

                <!-- Auto-Detect Result Confirmation Banner -->
                <TextView
                    android:id="@+id/text_dialog_autodetect_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#064e3b"
                    android:padding="7dp"
                    android:textColor="#a7f3d0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Pokemon 1 (Lead) Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/text_p1_role_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚔️ Slot 1 (Lead) &amp; Moveset"
                        android:textStyle="bold"
                        android:textColor="#38bdf8"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/text_p1_lead_br"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lead BR: 500 (N)"
                        android:textStyle="bold"
                        android:textColor="#f59e0b"
                        android:textSize="10sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_p1_autofill_moves"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="0dp"
                        android:text="Auto-Fill Moves"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="#0f172a"
                        android:textColor="#38bdf8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/edit_p1_name"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.8"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:completionThreshold="1"
                        android:dropDownWidth="280dp"
                        android:inputType="textCapWords"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="12sp"
                        android:hint="Name (e.g. Clodsire)" />

                    <EditText
                        android:id="@+id/edit_p1_cp"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="0.85"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="CP (auto)"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/edit_p1_ivs"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.05"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="IVs (0/15/15)"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edit_p1_fast"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Fast (auto)" />

                    <EditText
                        android:id="@+id/edit_p1_c1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 1" />

                    <EditText
                        android:id="@+id/edit_p1_c2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pokemon 2 (Safe Swap) Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/text_p2_role_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔄 Slot 2 (Safe Swap) &amp; Moveset"
                        android:textStyle="bold"
                        android:textColor="#c084fc"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/text_p2_swap_br"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swap BR: 500 (N)"
                        android:textStyle="bold"
                        android:textColor="#f59e0b"
                        android:textSize="10sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_p2_autofill_moves"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="0dp"
                        android:text="Auto-Fill Moves"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="#0f172a"
                        android:textColor="#c084fc" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/edit_p2_name"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.8"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:completionThreshold="1"
                        android:dropDownWidth="280dp"
                        android:inputType="textCapWords"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="12sp"
                        android:hint="Name (e.g. Feraligatr)" />

                    <EditText
                        android:id="@+id/edit_p2_cp"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="0.85"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="CP (auto)"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/edit_p2_ivs"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.05"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="IVs (0/15/15)"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edit_p2_fast"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Fast (auto)" />

                    <EditText
                        android:id="@+id/edit_p2_c1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 1" />

                    <EditText
                        android:id="@+id/edit_p2_c2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pokemon 3 (Closer) Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/text_p3_role_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛡️ Slot 3 (Closer) &amp; Moveset"
                        android:textStyle="bold"
                        android:textColor="#f59e0b"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/text_p3_swap_br"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swap BR: 500 (N)"
                        android:textStyle="bold"
                        android:textColor="#f59e0b"
                        android:textSize="10sp"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_p3_autofill_moves"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="0dp"
                        android:text="Auto-Fill Moves"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="#0f172a"
                        android:textColor="#f59e0b" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <AutoCompleteTextView
                        android:id="@+id/edit_p3_name"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.8"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:completionThreshold="1"
                        android:dropDownWidth="280dp"
                        android:inputType="textCapWords"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="12sp"
                        android:hint="Name (e.g. Mandibuzz)" />

                    <EditText
                        android:id="@+id/edit_p3_cp"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="0.85"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="CP (auto)"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/edit_p3_ivs"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.05"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="IVs (0/15/15)"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edit_p3_fast"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Fast (auto)" />

                    <EditText
                        android:id="@+id/edit_p3_c1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 1" />

                    <EditText
                        android:id="@+id/edit_p3_c2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="#0f172a"
                        android:paddingHorizontal="6dp"
                        android:textColor="#f8fafc"
                        android:textColorHint="#94a3b8"
                        android:textSize="11.5sp"
                        android:hint="Charged 2" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
